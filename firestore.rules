rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInEmail() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isCreateOwner() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function hasResourceEmail(field) {
      return signedIn()
        && resource.data.keys().hasAny([field])
        && signedInEmail() in resource.data[field];
    }

    function hasIncomingEmail(field) {
      return signedIn()
        && request.resource.data.keys().hasAny([field])
        && signedInEmail() in request.resource.data[field];
    }

    function isSharedParticipant() {
      return isOwner() || hasResourceEmail('sharedWith');
    }

    function isSharedEditor() {
      return hasResourceEmail('editors')
        || (
          !resource.data.keys().hasAny(['editors', 'commenters', 'viewers'])
          && hasResourceEmail('sharedWith')
        );
    }

    function sharingFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ownerId',
        'sharedWith',
        'shareAccess',
        'editors',
        'commenters',
        'viewers',
        'isShared',
        'isPublished',
        'sharedBy'
      ]);
    }

    // Private user documents (notes, notebooks, settings)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public registered user directory for lookups
    match /users_directory/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == email || request.auth.token.email.matches(email));
    }

    // Collaborative shared and publicly published notes
    match /shared_notes/{noteId} {
      allow read: if resource == null || resource.data.isPublished == true || isSharedParticipant();
      allow create: if isCreateOwner();
      allow update: if isOwner() || (isSharedEditor() && !sharingFieldsChanged());
      allow delete: if isOwner();
    }

    // Collaborative shared notebooks
    match /shared_notebooks/{notebookId} {
      allow read: if isSharedParticipant();
      allow create: if isCreateOwner();
      allow update: if isOwner() || (isSharedEditor() && !sharingFieldsChanged());
      allow delete: if isOwner();
    }

    // Lightweight shared comments.
    match /note_comments/{commentId} {
      allow read: if hasResourceEmail('participants');
      allow create: if signedIn() && request.resource.data.authorEmail == signedInEmail() && hasIncomingEmail('participants');
      allow update, delete: if signedIn() && resource.data.authorEmail == signedInEmail();
    }

    // Compact collaboration activity feed.
    match /activity_feed/{activityId} {
      allow read: if hasResourceEmail('participants');
      allow create: if signedIn() && request.resource.data.actorEmail == signedInEmail() && hasIncomingEmail('participants');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
